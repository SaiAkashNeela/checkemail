{
  "name": "checkemail",
  "version": "1.0.0",
  "description": "Fast, zero-dependency email validation: syntax, MX/DNS lookup, disposable detection, alias analysis, provider fingerprinting, and confidence scoring.",
  "packageManager": "bun@1.3.13",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "data"
  ],
  "scripts": {
    "build": "tsc",
    "serve": "bun run server.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "email",
    "validation",
    "email-validation",
    "email-verify",
    "disposable-email",
    "mx-lookup",
    "dns",
    "alias",
    "gmail",
    "spam"
  ],
  "author": "Sai Akash Neela",
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.4.2",
    "@types/node": "^20.11.25"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
